# Spreadsheets, CSV, Word and PDFs are blocked by default
*.xlsx
*.xls
*.csv
*.pdf
*.docx
*.doc

# Allow only the three PS-11 data pack workbooks under data/ (D72)
!data/
!data/PS-11_bank_statements.xlsx
!data/PS-11_invoices_and_reconciliation.xlsx
!data/PS-11_copilot_evaluation.xlsx

# local
.venv/
.env
.env.*
__pycache__/
*.egg-info/
.pytest_cache/
.streamlit/secrets.toml
scripts/out/
.copilot_state/
*.json
!pyproject.json
!docs/ps11-architecture.json
graphify-out/
.DS_Store

# Next.js web app (apps/web)
node_modules/
.next/
*.tsbuildinfo
# The *.json rule above would drop the web app's manifests; keep them.
!apps/web/package.json
!apps/web/package-lock.json
!apps/web/tsconfig.json
